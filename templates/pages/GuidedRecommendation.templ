package pages

import (
	"fmt"
	"switches/models"
	"switches/templates/layouts"
	"switches/templates/ui"
)

type Questions map[int]int
type Progress struct {
	Step      int
	Questions Questions
}

templ GuidedRecommendation(user models.User, progress Progress) {
	<style type="text/css">
    #guidedRecommendation {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    </style>
	<main id="guidedRecommendation">
		<div style="max-width: 400px">
			@ui.ProgressBar(progress.Step-1, len(questions))
		</div>
		<div>
			for _, question := range questions {
				@layouts.QuestionnaireCard(question, progress.Step)
			}
		</div>
		@ui.Button(ui.ButtonProp{
			ButtonText: "Previous",
			Target:     "#main",
			Patch:      "/switches/recommendations/guided/step",
			Vals:       fmt.Sprintf(`{"step":%d}`, progress.Step-1),
		})
		@ui.Button(ui.ButtonProp{
			ButtonText: "Next",
			Target:     "#main",
			Patch:      "/switches/recommendations/guided/step",
			Vals:       fmt.Sprintf(`{"step":%d}`, progress.Step+1),
		})
	</main>
}

var questions = []layouts.QuestionnaireCardProp{
	layouts.QuestionnaireCardProp{
		Question: layouts.QuestionData{
			Title: "First Question",
			Value: 1,
		},
		Options: []layouts.QuestionData{
			layouts.QuestionData{Title: "Answer 1", Value: 1},
			layouts.QuestionData{Title: "Answer 2", Value: 2},
			layouts.QuestionData{Title: "Answer 3", Value: 3},
		},
	},
	layouts.QuestionnaireCardProp{
		Question: layouts.QuestionData{
			Title: "Second Question",
			Value: 2,
		},
		Options: []layouts.QuestionData{
			layouts.QuestionData{Title: "Answer 1", Value: 1},
			layouts.QuestionData{Title: "Answer 2", Value: 2},
			layouts.QuestionData{Title: "Answer 3", Value: 3},
		},
	},
	layouts.QuestionnaireCardProp{
		Question: layouts.QuestionData{
			Title: "Third Question",
			Value: 3,
		},
		Options: []layouts.QuestionData{
			layouts.QuestionData{Title: "Answer 1", Value: 1},
			layouts.QuestionData{Title: "Answer 2", Value: 2},
			layouts.QuestionData{Title: "Answer 3", Value: 3},
		},
	},
	layouts.QuestionnaireCardProp{
		Question: layouts.QuestionData{
			Title: "Fourth Question",
			Value: 4,
		},
		Options: []layouts.QuestionData{
			layouts.QuestionData{Title: "Answer 1", Value: 1},
			layouts.QuestionData{Title: "Answer 2", Value: 2},
			layouts.QuestionData{Title: "Answer 3", Value: 3},
		},
	},
	layouts.QuestionnaireCardProp{
		Question: layouts.QuestionData{
			Title: "Fifth Question",
			Value: 5,
		},
		Options: []layouts.QuestionData{
			layouts.QuestionData{Title: "Answer 1", Value: 1},
			layouts.QuestionData{Title: "Answer 2", Value: 2},
			layouts.QuestionData{Title: "Answer 3", Value: 3},
		},
	},
}
